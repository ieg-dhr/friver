#!/usr/bin/env ruby

require 'csv'
require 'nokogiri'
require 'roo'
require 'kramdown'
require 'json'
require 'pry'

class FvImporter
  def run
    transcriptions
    translations
    archives(write: true)
  end

  def transcriptions
    data = {}
    text = []

    Dir['data/Transcriptions/*.xml'].each do |path|
      parts = path.split('/')
      file = parts.last
      id = file.split('.').first.to_i
      xml = File.read(path)
      doc = Nokogiri::XML(xml)

      title = doc.xpath('//tei:titleStmt')
      edition = doc.xpath('//tei:editionStmt')
      publication = doc.xpath('//tei:publicationStmt')

      # binding.pry
      # binding.pry if id == 36

      data[id] = {
        id: id,
        collection: title.xpath("tei:title[@level = 's']").text,
        date: title.xpath("tei:title[@level = 'a']/@when").to_s,
        legacyUrl: title.xpath("tei:title[@level = 'a']/@ref").to_s,
        language: doc.xpath('//tei:profileDesc/tei:langUsage').inner_text,
        title: title.xpath("tei:title[@level = 'a']").inner_text,
        abstract: to_html(clean(doc.xpath("//tei:front/tei:div[@type='Inhalt']").inner_html)),
        prints: to_html(clean(doc.xpath("//tei:front/tei:div[@type='Drucke']").inner_html)),
        # 'title.xml': title.xpath("tei:title[@level = 'a']").inner_html,

        # edition: edition.xpath('tei:edition').inner_text,
        # 'edition.xml': edition.xpath('tei:edition').inner_html,

        # funder: edition.xpath('tei:funder').inner_text,
        # 'funder.xml': edition.xpath('tei:funder').inner_html,

        # editor: edition.xpath('tei:editor').inner_text,
        # 'editor.xml': edition.xpath('tei:editor').inner_html,

        # publisher: publication.xpath('tei:publisher').inner_text,
        # 'publisher.xml': publication.xpath('tei:publisher').inner_html,

        # distributor: publication.xpath('tei:distributor').inner_text,
        # 'distributor.xml': publication.xpath('tei:distributor').inner_html,

        # licenseId: publication.xpath('tei:availability/tei:licence/@target').to_s,
        # license: publication.xpath('tei:availability/tei:licence').inner_text,
        # 'license.xml': publication.xpath('tei:availability/tei:licence').inner_html,

        source: doc.xpath('//tei:sourceDesc/tei:msDesc').inner_text,
        # 'source.xml': doc.xpath('//tei:sourceDesc').inner_html,

        signatories: doc.xpath("//tei:listPerson/tei:person[@role = 'signatory']").map{ |p|
          {
            name: p.inner_text.strip,
            # projectId: p['xml:id'],
            gnd: p.xpath('tei:persName/@ref').to_s
          }
        },

        places: doc.xpath('//tei:listPlace/tei:place').map{ |p|
          {
            name: p.inner_text.strip,
            # projectId: p['xml:id'],
            gnd: p.xpath('tei:placeName/@ref').to_s
          }
        },

        styles: styles_for(doc)
      }

      text << doc.xpath("//tei:text//tei:div[@type = 'Transliteration']").inner_text

      archive_id = doc.xpath('//tei:sourceDesc/tei:repository/@xml:id').to_s
      if archive_id && archive_id != ''
        archive = archives[archive_id]
        
        if archive
          data[id]['archiveId'] = archive_id
          label = clean([
            doc.xpath('//tei:sourceDesc/tei:repository/tei:note').inner_html,
            doc.xpath('//tei:sourceDesc/tei:msDesc').inner_html
          ].join("\n"))

          if label && label != ''
            data[id]['archiveLabel'] = to_html(label)
          end
        end
      end

      data[id] = clean(data[id])
    end

    File.open 'src/data.json', 'w+' do |f|
      data.each do |k, v|
        binding.pry if v.has_key?(:language) && v[:language] == nil
      end
      f.puts JSON.pretty_generate(data)
    end

    filters = []

    text = text.
      select{|t| !t.nil? && t && t != ''}.
      join(' ').
      gsub("'", ' ').
      # gsub(/[.;,-_"\(\)\[\]]/, '').
      gsub(/\s+/, ' ').
      split(' ').
      select{|w| w.size > 6}.
      select{|w| !filters.include?(w)}.
      join(' ')

    frequencies = {}
    text.split(' ').each do |w|
      frequencies[w] ||= 0
      frequencies[w] += 1
    end

    File.open 'src/frequencies.json', 'w+' do |f|
      f.puts JSON.pretty_generate(frequencies)
    end

    File.open 'src/data.txt', 'w+' do |f|
      f.puts text
    end
  end

  def styles_for(doc)
    result = []

    nodes = doc.xpath("//tei:text//tei:div[@type = 'Edition']")
    if nodes.size > 0
      result << {'id' => 'edition', 'type' => 'edition'}
    end

    nodes = doc.xpath("//tei:text//tei:div[@type = 'Transliteration']")
    if nodes.size > 0
      result << {'id' => 'transliteration', 'type' => 'transliteration'}
    end

    nodes = doc.xpath("//tei:standOff/tei:facsimile/tei:surface")
    if nodes.size > 0
      result << {'id' => 'facsimile', 'type' => 'facsimile'}
    end

    doc.xpath("//tei:text//tei:listBibl/tei:bibl").each.with_index do |bibl, i|
      nodes = bibl.xpath("tei:biblScope/tei:graphic")
      if nodes.size > 0
        result << {'id' => "bibl-#{i}", 'type' => 'bibl', 'index' => i}
      end
    end

    nodes = doc.xpath("//tei:text//tei:div[@type = 'Drucke']//tei:ref")
    if nodes.size > 0
      result << {'id' => 'print', 'type' => 'print'}
    end

    result
  end

  def translations
    data = {'de' => {}}

    file = 'src/translations.xlsx'
    puts "using translations from #{file}"

    xlsx = Roo::Spreadsheet.open(file)

    each_row xlsx, skip: 0 do |row|
      id = row.delete('id')
      row['de'].gsub!(/ -/, ' &#8209;') if row['de'].is_a?(String)
      data['de'][id] = row['de']
    end

    File.open 'src/translations.json', 'w' do |f|
      f.write JSON.pretty_generate(data)
    end
  end


  protected

    def each_row(xlsx, sheet_name: nil, skip: 1, &block)
      sheet = (sheet_name ? xlsx.sheet_for(sheet_name) : xlsx.sheet(0))
      headers = sheet.row(skip + 1)

      ((skip + 2)..sheet.last_row).each do |i|
        row = headers.zip(sheet.row(i)).to_h.compact

        yield row
      end
    end

    def clean(str)
      case str
      when Array then str.map{|s| clean(s)}
      when Hash
        str.transform_values{|s| clean(s)}.compact
      when String
        result = str.
          gsub(/\n/, '').
          gsub(/[ \t]+/, ' ').
          strip

        return nil if result == 'null'
        return nil if result == ''
        
        result
      else
        str
      end
    end

    def archives(write: false)
      unless @archives
        @archives = CSV.
          read('data/ieg_treaty_archives_id_names_list.csv', headers: true).
          map{|r| {'id' => r['xml-id'], 'short' => r['archive-label']}}.
          to_h{|h| [h['id'], h]}
      end

      if write
        str = JSON.pretty_generate(@archives)
        File.write "src/archives.json", str
      end

      @archives
    end

    def to_html(xml)
      xml = Nokogiri::XML::DocumentFragment.parse(xml)
      xml.xpath('.//lb').each do |lb|
        lb.replace('<br />')
      end
      xml.xpath('.//ref').each do |ref|
        href = ref['target']
        next unless href

        label = ref.text

        domains = [
          'digital.ub.uni-duesseldorf.de',
          'gallica.bnf.fr',
          'diplomatie.gouv.fr',
          'archivinformationssystem.at',
          'gahetna.nl',
          'siv.archives-nationales.culture.gouv.fr',
          'digitarq.arquivos.pt',
          'mcu.es',
          'archive.nrw.de',
          'rgada.info',
          'gda.bayern.de',
          'digbib.bibliothek.uni-augsburg.de',
          'archiv.sachsen.de',
          'sok.riksarkivet.se',
          'archiviodistatotorino.it',
          'jacobite.ca',
          'eleveltar.hu',
          'archivdatenbank.gsta.spk-berlin.de',
          'sa.dk',
          'archivi.beniculturali.it',
          'digital.ub.uni-duesseldorf.de',
          'arcinsys.hessen.de',
          'bib-bvb.de',
          'francearchives.fr',
          'agad.gov.pl',
          'yale.edu',
          'discovery.nationalarchives.gov.uk',
          'query-staatsarchiv.lu.ch',
          'suche.staatsarchiv.djiktzh.ch',
          'stadtarchiv-luebeck.findbuch.net',
          'staatsarchiv-findsystem.gr.ch',
          'ge.ch',
          'asmilano.it',
          'hrono.ru',
          'books.google.de',
          'questia.com',
          'pax-westphalica.de'
        ]

        domains.each do |domain|
          if href.match?(domain)
            label += "<svg is=\"icon\" type=\"book-open\" class=\"ms-1\"></svg>"
          end
        end

        ref.replace("<a href=\"#{href}\">#{label}</a>")
      end

      xml.inner_html
    end
end

FvImporter.new.run
