<super-page class="d-flex flex-column flex-lg-row">
  <img class="logo d-none d-md-block" src="{config['FV_STATIC_URL']}/assets/logo.svg" />

  <div class="d-flex position-relative">
    <div class="container w-auto">
      <h1 class="my-5 pe-5"><raw html={t('super_title')} /></h1>

      <p class="serif mb-5">
        <raw html={t('super_text')} />
      </p>
    </div>

    <img class="europe-map" src="/assets/europe-map.svg" />

    <navigation class="mt-5 d-none d-md-block" />
  </div>

  <div class="bg-black text-white position-relative p-5">
    <div class="row align-items-md-center justify-content-lg-around h-100">
      <div class="col-12 col-md-3 offset-md-1 col-lg-12 offset-lg-0 text-center">
        <a
          class="btn btn-primary btn-lg text-start fw-semibold text-center"
          href="/start?flavor=search"
        >
          {cap(t('to_search'))}
        </a>
      </div>

      <div class="d-none d-md-block col-md-4 col-lg-12 px-5 text-center">
        <img
          src="/assets/wordcloud.svg"
          class="dove"
        />
      </div>

      <div class="col-12 col-md-3 col-lg-12 offset-lg-0 text-center mt-5 mt-md-0">
        <a
          class="btn btn-primary btn-lg text-start fw-semibold text-center"
          href="/start?flavor=about"
        >
          {cap(t('about'))}
        </a>
      </div>
    </div>

    <navigation class="mt-5 d-md-none" />
  </div>


  <script>
    import {default as config} from '../../.env.js'

    export default class {
      onBeforeMount() {
        this.config = config
      }
    }
  </script>
</super-page>
