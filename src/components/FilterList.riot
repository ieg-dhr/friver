<filter-list>
  <ul class="list-unstyled">
    <li each={item in props.items} class="d-flex">
      <a
        onclick={event => toFilter(item, event)}
        class="flex-grow-1"
      >{item.name}</a>&nbsp;<!--
   --><a href={item.gnd} target="_blank" class="ms-3"><!--
     --><svg is="icon" type="arrow-right"></svg>
      </a>
    </li>
  </ul>

  <script>
    import Icon from './Icon.riot'
    import {addMultiParam} from '../lib/util'

    export default class {
      static components = {Icon}

      toFilter(item, event) {
        event.preventDefault()

        addMultiParam(this.props.type, item.name)
        this.emit('open-offcanvas')
      }
    }
  </script>
</filter-list>