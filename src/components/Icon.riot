<icon
  width={props.width}
  height={props.height}
  fill={props.fill}
  stroke={props.stroke}
  stroke-width={props.strokeWidth}
  stroke-linecap={props.strokeLinecap}
  stroke-linejoin={props.strokeLinejoin}
  class={props.class}
>
  <use href={href()} />

  <script>
    import {default as config} from '../../.env.js'

    export default class {
      href() {
        const t = this.props.type || 'chevron-down'

        return `${config['FV_STATIC_URL']}/assets/feather-sprite.svg#${t}`
      }
    }
  </script>
</icon>